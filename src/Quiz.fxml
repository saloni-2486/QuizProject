<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0"
            prefWidth="700.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="QuizController"
            style="-fx-background-color: linear-gradient(to bottom right, #DDE7FF, #E8DEFF, #F5F3FF);">

    <children>

        <!-- Header -->

        <Label layoutX="50.0"
               layoutY="28.0"
               text="QUIZ"
               style="-fx-font-size: 30px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #1F2A44;" />

        <Label fx:id="questionNumberLabel"
               layoutX="520.0"
               layoutY="38.0"
               text="Question 1 of 5"
               style="-fx-font-size: 15px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #53627D;" />

        <Label fx:id="timerLabel"
               layoutX="520.0"
               layoutY="60.0"
               text="TIME LEFT: 02:00"
               style="-fx-font-size: 14px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #4F6DF5;" />

        <!-- Progress -->

        <ProgressBar fx:id="progressBar"
                     layoutX="50.0"
                     layoutY="78.0"
                     prefWidth="600.0"
                     prefHeight="10.0"
                     progress="0.2"
                     style="-fx-accent: #5F6FF5;" />

        <!-- Question Card -->

        <VBox layoutX="50.0"
              layoutY="115.0"
              prefWidth="600.0"
              prefHeight="310.0"
              spacing="18"
              style="-fx-background-color: white;
                     -fx-background-radius: 18;
                     -fx-padding: 28;
                     -fx-effect: dropshadow(gaussian, rgba(50,60,100,0.15), 15, 0.2, 0, 5);">

            <Label fx:id="questionLabel"
       text="Question"
       wrapText="true"
       maxWidth="540"
       style="-fx-font-size: 20px;
              -fx-font-weight: bold;
              -fx-text-fill: #1F2A44;" />

            <RadioButton fx:id="option1"
                         text="Option 1"
                         toggleGroup="$options"
                         style="-fx-font-size: 16px;
                                -fx-text-fill: #46536B;" />

            <RadioButton fx:id="option2"
                         text="Option 2"
                         toggleGroup="$options"
                         style="-fx-font-size: 16px;
                                -fx-text-fill: #46536B;" />

            <RadioButton fx:id="option3"
                         text="Option 3"
                         toggleGroup="$options"
                         style="-fx-font-size: 16px;
                                -fx-text-fill: #46536B;" />

            <RadioButton fx:id="option4"
                         text="Option 4"
                         toggleGroup="$options"
                         style="-fx-font-size: 16px;
                                -fx-text-fill: #46536B;" />

        </VBox>

        <!-- Toggle Group -->

        <fx:define>
            <ToggleGroup fx:id="options"/>
        </fx:define>

        <!-- Next Button -->

        <Button layoutX="500.0"
                layoutY="445.0"
                prefWidth="150.0"
                prefHeight="45.0"
                text="NEXT"
                onAction="#submitAnswer"
                style="-fx-font-size: 16px;
                       -fx-font-weight: bold;
                       -fx-text-fill: white;
                       -fx-background-color: linear-gradient(to right, #4F6DF5, #7657E8);
                       -fx-background-radius: 12;
                       -fx-cursor: hand;" />

    </children>

</AnchorPane>