<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="20"
      prefHeight="500.0"
      prefWidth="700.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ResultController"
      style="-fx-background-color: linear-gradient(to bottom right, #DDE7FF, #E8DEFF, #F5F3FF);">

    <Button text="⌂ HOME"
        prefWidth="100"
        prefHeight="35"
        onAction="#goHome"
        style="-fx-font-size: 13px;
               -fx-font-weight: bold;
               -fx-text-fill: #4F6DF5;
               -fx-background-color: transparent;
               -fx-cursor: hand;" />

    <!-- Main Heading -->

    <Label text="QUIZ COMPLETE!"
           style="-fx-font-size: 34px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #1F2A44;" />

    <!-- Score Card -->

    <VBox alignment="CENTER"
          spacing="8"
          prefWidth="400"
          prefHeight="130"
          style="-fx-background-color: white;
                 -fx-background-radius: 18;
                 -fx-padding: 20;
                 -fx-effect: dropshadow(gaussian, rgba(50,60,100,0.15), 15, 0.2, 0, 5);">

        <Label text="YOUR SCORE"
               style="-fx-font-size: 14px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #687691;" />

        <Label fx:id="scoreLabel"
               text="Your Score: 0 / 5"
               style="-fx-font-size: 28px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #4F6DF5;" />

    </VBox>

    <!-- Performance Message -->

    <Label fx:id="messageLabel"
           text="Good job! Keep it up!"
           style="-fx-font-size: 18px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #53627D;" />

    <!-- Buttons -->

    <Button text="PLAY AGAIN"
            prefWidth="250"
            prefHeight="45"
            onAction="#playAgain"
            style="-fx-font-size: 16px;
                   -fx-font-weight: bold;
                   -fx-text-fill: white;
                   -fx-background-color: linear-gradient(to right, #4F6DF5, #7657E8);
                   -fx-background-radius: 12;
                   -fx-cursor: hand;" />

    <Button text="CHOOSE ANOTHER SUBJECT"
            prefWidth="250"
            prefHeight="45"
            onAction="#chooseSubject"
            style="-fx-font-size: 14px;
                   -fx-font-weight: bold;
                   -fx-text-fill: #4F6DF5;
                   -fx-background-color: white;
                   -fx-background-radius: 12;
                   -fx-border-color: #4F6DF5;
                   -fx-border-radius: 12;
                   -fx-cursor: hand;" />

</VBox>